<?xml version="1.0" encoding="utf-8"?>
<!--
  这个项目只用到一个 NuGet 包（Microsoft.Web.WebView2），而沙箱 / 公司网络里
  dotnet restore 走 HTTPS 常常直接失败（报 NU1301 + "SSL connection could not be established"）。

  所以默认只用本地 feed 目录：先跑

      node tools/fetch-nupkg.mjs

  它会用 Node 把 .nupkg 下到 feed/ 里，之后 dotnet build 完全离线。

  如果你的机器上网正常，删掉这个文件（或把 <clear /> 换成 nuget.org）就行。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="feed" />
  </packageSources>
</configuration>
